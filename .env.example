# Backend API URL
# For local development: http://localhost:4000
# For production: https://api.parkflow.com
VITE_API_URL=http://localhost:4000

# PaddleOCR license-plate service (see ocr-service/README.md)
VITE_OCR_API_URL=http://localhost:8868

# Optional fallback OCR engine when the PaddleOCR service is down
VITE_GEMINI_API_KEY=
